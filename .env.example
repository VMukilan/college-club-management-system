# ==============================================================================
# Environment Configuration Template – College Club Management System (v0.4)
# Copy this file to .env and adjust variables as needed for production deployment
# ==============================================================================

# Cryptographic secret key for session cookie signing (replace with strong random value)
SECRET_KEY=replace-with-a-very-strong-cryptographic-random-key-in-production

# Application Environment (production / development)
FLASK_ENV=production

# SQLite database file name located within /app/instance/
DATABASE_NAME=college_club.db

# HTTP Listening Port
PORT=5000

# Host binding (127.0.0.1 for local standalone, 0.0.0.0 for containerized)
FLASK_HOST=0.0.0.0

# Debug flag (0 in production, 1 only in development)
FLASK_DEBUG=0
